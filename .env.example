# ============================================================
# Green Acres / Society OS — Environment Configuration Example
# ============================================================

# Database Connections
# CRITICAL SECURITY NOTE:
# 1. DATABASE_URL must connect with owner/admin privileges (e.g. neondb_owner)
#    and is STRICTLY restricted to running migrations, database seeding, and trusted tasks.
# 2. APP_DATABASE_URL must connect as an unprivileged application role (e.g. app_user)
#    with NOBYPASSRLS enabled. All tenant application queries run through APP_DATABASE_URL
#    under PostgreSQL Row Level Security (RLS).
DATABASE_URL="postgresql://neondb_owner:password@host.neon.tech/neondb?sslmode=require"
APP_DATABASE_URL="postgresql://app_user:password@host.neon.tech/neondb?sslmode=require"

# Authentication & Sessions
# CRITICAL: Generate high-entropy 256-bit secrets (openssl rand -hex 32).
# Rotate secrets periodically. In production, never commit actual secrets to version control.
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-prod"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-prod"

# OTP Configuration
# Provider: mock | msg91 | twilio
# In production, set OTP_PROVIDER to a real SMS gateway (e.g. msg91 or twilio)
# and ensure MOCK_OTP_ENABLED is false. Mock provider is hard-disabled in NODE_ENV=production.
OTP_PROVIDER="mock"
MOCK_OTP_ENABLED="true"
# MSG91 Provider credentials (when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=""

# Payments Configuration
# Gateway: mock | razorpay
# In production, set PAYMENT_GATEWAY=razorpay and supply live production keys.
# Mock payment provider is hard-disabled in NODE_ENV=production.
PAYMENT_GATEWAY="mock"
# Razorpay API Credentials (when PAYMENT_GATEWAY=razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Runtime Environment
NODE_ENV="development"
PORT=4000
